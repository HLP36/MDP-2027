generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// ENUMS
// ======================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum OrganizationalUnitType {
  GLOBAL
  COUNTRY
  PROVINCE
  CITY
  DISTRICT
  GROUP
  TEAM
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SUSPEND
  RESTORE
  LOGIN
  LOGOUT
  VALIDATE
  REJECT
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ActivityStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ParticipationStatus {
  REGISTERED
  PRESENT
  ABSENT
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  VALIDATED
  REJECTED
  RETURNED
}

enum ContributionType {
  MEMBER_CONTRIBUTION
  DONATION
  SPONSORSHIP
  PROJECT_CONTRIBUTION
  OTHER
}

enum ContributionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CARD
  OTHER
}

enum ProjectStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  SUSPENDED
  CANCELLED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SponsorType {
  INDIVIDUAL
  COMPANY
  ORGANIZATION
  CHURCH
  OTHER
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

// ======================================================
// USERS
// ======================================================

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  status       UserStatus @default(PENDING)

  managerId String?
  manager   User?   @relation("UserHierarchy", fields: [managerId], references: [id])
  subordinates User[]  @relation("UserHierarchy")

  organizationalUnitId String?
  organizationalUnit   OrganizationalUnit? @relation("UserOrganizationalUnit", fields: [organizationalUnitId], references: [id])

  ledOrganizationalUnits OrganizationalUnit[] @relation("OrganizationalUnitLeader")

  roles UserRole[]

  auditLogs AuditLog[]

  activitiesCreated Activity[] @relation("ActivityCreator")

  reportsCreated Report[] @relation("ReportCreator")

  reportsValidated Report[] @relation("ReportValidator")

  contributionsCreated Contribution[] @relation("ContributionCreator")

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([managerId])
  @@index([organizationalUnitId])
  @@index([status])
  @@map("users")
}

// ======================================================
// ROLES
// ======================================================

model Role {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?

  level    Int     @default(0)
  isSystem Boolean @default(false)

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

// ======================================================
// PERMISSIONS
// ======================================================

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

// ======================================================
// USER ROLES
// ======================================================

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ======================================================
// ROLE PERMISSIONS
// ======================================================

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ======================================================
// ORGANIZATIONAL UNITS
// ======================================================

model OrganizationalUnit {
  id          String                 @id @default(uuid())
  name        String
  type        OrganizationalUnitType
  description String?

  parentId String?
  parent   OrganizationalUnit?  @relation("OrganizationalHierarchy", fields: [parentId], references: [id])
  children OrganizationalUnit[] @relation("OrganizationalHierarchy")

  leaderId String?
  leader   User?   @relation("OrganizationalUnitLeader", fields: [leaderId], references: [id])

  users   User[]   @relation("UserOrganizationalUnit")
  members Member[]
  reports Report[]

  isActive Boolean @default(true)

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  activities Activity[]

  @@index([parentId])
  @@index([leaderId])
  @@index([type])
  @@map("organizational_units")
}

// ======================================================
// MEMBERS
// ======================================================

model Member {
  id String @id @default(uuid())

  firstName String
  lastName  String

  email String?
  phone String?

  address String?

  status MemberStatus @default(ACTIVE)

  organizationalUnitId String?
  organizationalUnit   OrganizationalUnit? @relation(fields: [organizationalUnitId], references: [id], onDelete: SetNull)

  activityParticipations ActivityParticipant[]
  contributions          Contribution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationalUnitId])
  @@index([status])
  @@index([email])
  @@map("members")
}

// ======================================================
// ACTIVITIES
// ======================================================

model Activity {
  id String @id @default(uuid())

  title       String
  description String?

  status ActivityStatus @default(DRAFT)

  startDate DateTime
  endDate   DateTime?

  location String?

  organizationalUnitId String?
  organizationalUnit   OrganizationalUnit? @relation(fields: [organizationalUnitId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("ActivityCreator", fields: [createdById], references: [id])

  participants ActivityParticipant[]
  reports      Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationalUnitId])
  @@index([createdById])
  @@index([status])
  @@index([startDate])
  @@map("activities")
}

// ======================================================
// ACTIVITY PARTICIPANTS
// ======================================================

model ActivityParticipant {
  activityId String
  memberId   String

  status ParticipationStatus @default(REGISTERED)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  registeredAt DateTime @default(now())

  @@id([activityId, memberId])
  @@index([memberId])
  @@map("activity_participants")
}

// ======================================================
// REPORTS
// ======================================================

model Report {
  id String @id @default(uuid())

  title   String
  content String?

  status ReportStatus @default(DRAFT)

  organizationalUnitId String
  organizationalUnit   OrganizationalUnit @relation(fields: [organizationalUnitId], references: [id])

  activityId String?
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("ReportCreator", fields: [createdById], references: [id])

  validatedById String?
  validatedBy   User?   @relation("ReportValidator", fields: [validatedById], references: [id], onDelete: SetNull)

  validatedAt DateTime?

  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationalUnitId])
  @@index([activityId])
  @@index([createdById])
  @@index([validatedById])
  @@index([status])
  @@map("reports")
}

// ======================================================
// CONTRIBUTIONS
// ======================================================

model Contribution {
  id String @id @default(uuid())

  amount Decimal @db.Decimal(15, 2)

  currency String @default("USD")

  type ContributionType @default(MEMBER_CONTRIBUTION)

  status ContributionStatus @default(PENDING)

  paymentMethod PaymentMethod?

  reference String?

  description String?

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  sponsorId String?
  sponsor   Sponsor? @relation(fields: [sponsorId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("ContributionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([projectId])
  @@index([sponsorId])
  @@index([createdById])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("contributions")
}

// ======================================================
// PROJECTS
// ======================================================

model Project {
  id String @id @default(uuid())

  code String @unique

  name        String
  description String?

  status ProjectStatus @default(DRAFT)

  priority ProjectPriority @default(MEDIUM)

  estimatedBudget Decimal? @db.Decimal(15, 2)

  collectedAmount Decimal @default(0) @db.Decimal(15, 2)

  startDate DateTime?
  endDate   DateTime?

  location String?

  contributions Contribution[]
  sponsors      ProjectSponsor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@map("projects")
}

// ======================================================
// SPONSORS
// ======================================================

model Sponsor {
  id String @id @default(uuid())

  name String

  type SponsorType @default(INDIVIDUAL)

  email String?
  phone String?

  address String?

  description String?

  contributions Contribution[]
  projects      ProjectSponsor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([email])
  @@map("sponsors")
}

// ======================================================
// PROJECT SPONSORS
// ======================================================

model ProjectSponsor {
  projectId String
  sponsorId String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sponsor Sponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  amount Decimal? @db.Decimal(15, 2)

  createdAt DateTime @default(now())

  @@id([projectId, sponsorId])
  @@index([sponsorId])
  @@map("project_sponsors")
}

// ======================================================
// NOTIFICATIONS
// ======================================================

model Notification {
  id String @id @default(uuid())

  title   String
  message String

  type NotificationType @default(INFO)

  isRead Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ======================================================
// AUDIT LOGS
// ======================================================

model AuditLog {
  id String @id @default(uuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action AuditAction

  entity   String
  entityId String?

  oldValues Json?
  newValues Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}